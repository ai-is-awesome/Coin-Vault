# Coin Vault API configuration.
# Copy this file to apps/api/.env (next to this file) and fill it in. That file is gitignored.

# =====================================================================================
# Database (PostgreSQL 14+)
# =====================================================================================
# Pick ONE of the options below.
#
# --- Option A: local Postgres or Docker (`npm run db:up`) -----------------------------
#   DATABASE_URL=postgresql://coinvault:coinvault@localhost:5432/coinvault
#
# --- Option B: Supabase ---------------------------------------------------------------
# Dashboard -> Connect -> "Connection string". You need two URLs that differ only in the port:
#   DATABASE_URL  Transaction pooler (port 6543), used by the running API.
#   DIRECT_URL    Session pooler (port 5432), used by the Prisma CLI (migrations, Studio).
#                 Migrations take advisory locks, which the transaction pooler doesn't support.
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=coinvault
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=coinvault
#
#   - <password> is your database password (Project Settings -> Database), without brackets.
#     URL-encode special characters: @ -> %40   # -> %23   / -> %2F   : -> %3A   ? -> %3F
#   - `schema=coinvault` keeps the tables out of `public`, which Supabase exposes through its
#     auto-generated REST API (anyone with the project's anon key could read the users table).
#     Alternatively, disable the Data API in the Supabase dashboard.
#
# --- Option C: any other hosted Postgres (Neon, RDS, ...) -----------------------------
# Use the pooled URL as DATABASE_URL and the direct (non-pooled) URL as DIRECT_URL.
# Without a pooler, set only DATABASE_URL.

DATABASE_URL=postgresql://coinvault:coinvault@localhost:5432/coinvault
# DIRECT_URL=

# Optional. Tests (`npm test`) use an isolated "coinvault_test" schema inside the same database,
# so they never touch your app data. Set this to use a separate database instead.
# DATABASE_URL_TEST=

# =====================================================================================
# Server & auth
# =====================================================================================
PORT=4000
# At least 32 random characters. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime (default 7 days).
JWT_EXPIRES_IN_SECONDS=604800

# =====================================================================================
# Behaviour
# =====================================================================================
# Simulated latency of the mock payment provider, in milliseconds.
MOCK_PAYMENT_LATENCY_MS=600
# Brute-force protection on /api/auth/login and /api/auth/register.
RATE_LIMIT_ENABLED=true
# Which proxies may report the client IP via X-Forwarded-For. Default false = ignore the header,
# so nobody can spoof their IP. In production behind a load balancer / CDN that appends
# X-Forwarded-For in front of the web app, set this to 1.
TRUST_PROXY=false
