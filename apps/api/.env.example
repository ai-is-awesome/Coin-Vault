# Coin Vault API configuration.
# Copy this file to apps/api/.env (next to this file) and fill it in. That file is gitignored.

# =====================================================================================
# Main settings: these three are all you normally need
# =====================================================================================
# The values below work as-is with the Docker database (`npm run db:up`).

# Database the API connects to. Supports ?schema=<name>.
DATABASE_URL=postgresql://coinvault:coinvault@localhost:5432/coinvault

# Database the Prisma CLI uses for migrations and Studio. Same as DATABASE_URL unless
# DATABASE_URL goes through a connection pooler (Supabase, Neon), see below.
DIRECT_URL=postgresql://coinvault:coinvault@localhost:5432/coinvault

# Signs session tokens. At least 32 random characters (mandatory in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# -------------------------------------------------------------------------------------
# Using Supabase instead? Replace the two URLs above with these.
# Both come from Dashboard -> Connect -> "Connection string" and differ only in the port:
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=coinvault
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=coinvault
#
#   - Port 6543 is the transaction pooler, for the running API. Port 5432 is the session
#     pooler, for migrations. Migrations take advisory locks, which the transaction
#     pooler doesn't support.
#   - <password> is your database password, without brackets. URL-encode special
#     characters: @ -> %40   # -> %23   / -> %2F   : -> %3A   ? -> %3F
#   - `schema=coinvault` keeps the tables out of `public`, which Supabase exposes through
#     its auto-generated REST API.
#
# Other hosted Postgres (Neon, RDS, ...): DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
# -------------------------------------------------------------------------------------

# =====================================================================================
# Optional (defaults shown). Uncomment to change.
# =====================================================================================
# PORT=4000
# JWT_EXPIRES_IN_SECONDS=604800        # session length (7 days)
# MOCK_PAYMENT_LATENCY_MS=300          # simulated payment provider delay
# RATE_LIMIT_ENABLED=true              # brute-force and abuse protection
# TRUST_PROXY=false                    # set to 1 behind a load balancer/CDN that appends X-Forwarded-For
# COOKIE_SECURE=true                   # Secure-only session cookie; default: true in production only
# LOG_LEVEL=info                       # silent | error | warn | info | debug
# DATABASE_URL_TEST=                   # tests default to a "coinvault_test" schema in DATABASE_URL's database
